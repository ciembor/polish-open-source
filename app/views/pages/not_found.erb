<section class="not-found">
  <div class="not-found__inner content">
    <p class="not-found__code" aria-hidden="true">404</p>
    <div class="not-found__content">
      <p class="eyebrow"><%= h t('not_found.eyebrow') %></p>
      <h1><%= h t('not_found.title') %></h1>
      <p class="lede"><%= h t('not_found.body') %></p>
      <div class="not-found__actions">
        <a class="not-found__action not-found__action--primary" href="<%= h app_path(@not_found_action_path) %>"><%= h @not_found_action_label %></a>
      </div>
    </div>
  </div>
</section>
