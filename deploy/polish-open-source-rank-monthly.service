[Unit]
Description=Polish Open Source Rank monthly snapshot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/home/ciembor/polish-open-source-rank
EnvironmentFile=/home/ciembor/polish-open-source-rank/.env.local
Restart=on-failure
RestartSec=60
TimeoutStartSec=infinity
TimeoutStopSec=45
Nice=19
IOSchedulingClass=idle
CPUQuota=20%
CPUWeight=1
IOWeight=1
ExecStartPre=/usr/bin/mkdir -p /home/ciembor/polish-open-source-rank/tmp
ExecStartPre=-/usr/bin/podman rm -f polish-open-source-rank-monthly
ExecStart=/usr/bin/flock -n /home/ciembor/polish-open-source-rank/tmp/crawl.lock /usr/bin/podman run --name=polish-open-source-rank-monthly --user=1000:1000 --read-only --tmpfs /app/tmp:rw,noexec,nosuid,nodev,size=64m --memory=768m --memory-swap=768m --memory-reservation=384m --cpus=0.25 --cpu-shares=64 --blkio-weight=10 --pids-limit=256 --env-file /home/ciembor/polish-open-source-rank/.env.local -e TZ=Europe/Warsaw -e RACK_ENV=production -e APP_BASE_PATH=/ -e BASE_URL=https://polish-open-source.pl -v /home/ciembor/polish-open-source-rank/db:/app/db:rw -v /home/ciembor/polish-open-source-rank/log:/app/log:rw localhost/polish-open-source-rank:latest bundle exec ruby bin/monthly_rankings
ExecStop=-/usr/bin/podman stop --time 30 polish-open-source-rank-monthly
ExecStopPost=-/usr/bin/podman rm -f polish-open-source-rank-monthly
